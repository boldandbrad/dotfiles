#!/usr/bin/env bash
#
# curator: manager of your digital music library

# WARNING: this script will modify music files directly. backup original source
# files before running this script on them.

# dependencies: ffmpeg, ffprobe, curl, jq, flac, id3v2

# library folder structure: library/artist/year - album/[d]track - title.ext

version="v0.1.0"

# TODO: take library in as an argument or env variable
import_dir=~/Music/Import
library_dir=~/Music/TestLibrary
# archive_dir=~/Music/Archive

directories=("$import_dir" "$library_dir")
for directory in ${directories[@]}
do
  if [[ ! -d "$directory" ]]; then
    mkdir -p "$directory"
  fi
done

supported_formats=("flac" "mp3")

start_time=$(date +%s)

help_msg() {
  echo "help"
}

_get_tags() {
  ffprobe -v quiet -print_format json -show_format "$1" 2>/dev/null
}

_clean_path() {
  local path="$1"
  # TODO: handle more filepath illegal characters (? \n)
  local path_cleaned=${path////_} # replace forward slashes with underscores
  echo "$path"
}

_remove_explicit() {
  local string="$1"
  string=${string% Explicit}
  string=${string%Explicit}
  string=${string% (Explicit)}
  string=${string%(Explicit)}
  echo "$string"
}

_format_artistdir() {
  local album_artist="$1"

  local album_artist_cleaned=$(_clean_path "$album_artist")
  # Move 'The' to the end for sorting purposes
  if [[ "$album_artist_cleaned" == "The "* ]]; then
    album_artist_cleaned="${album_artist_cleaned#The }, The"
  fi

  echo "$album_artist_cleaned"
}

_format_albumdir() {
  local album="$1"
  local release_date="$2"

  album=$(_remove_explicit "$album")
  local album_cleaned=$(_clean_path "$album")

  echo "$release_date - $album_cleaned"
}

_format_filename() {
  local disc="$1"
  local track="$2"
  local title="$3"

  local title_cleaned=$(_clean_path "$title")
  if [[ $track =~ ^[0-9]+$ ]]; then
    printf -v track '%02d' "$track"
  else
    track=""
  fi

  if [[ $disc =~ ^[0-9]+$ && $disc_total =~ ^[0-9]+$ && $disc_total -gt 1 ]]; then
    filebase="$disc$track - $title_cleaned"
  else
    filebase="$track - $title_cleaned"
  fi

  echo "$filebase"
}

_fetch_lyrics() {
  echo "todo"
}

import() {
  echo "Importing from $import_dir"

  count_imported=0
  count_skipped=0
  count_lyriced=0
  count_retagged=0

  while IFS= read -r -d '' source_file; do
    ext="${source_file##*.}"
    ext=$(printf '%s' "$ext" | tr '[:upper:]' '[:lower:]')
    source_file_base="${source_file##*/}"
    source_file_base="${source_file_base%.*}"
    echo "$source_file_base"

    tags_json=$(_get_tags "$source_file")
    artist=$(jq -r '.format.tags.ARTIST // .format.tags.artist // ""' <<<"$tags_json")
    album=$(jq -r '.format.tags.ALBUM // .format.tags.album // ""' <<<"$tags_json")
    album_artist=$(jq -r '.format.tags.ALBUM_ARTIST // .format.tags.album_artist // ""' <<<"$tags_json")
    year=$(jq -r '.format.tags.DATE // .format.tags.date // ""' <<<"$tags_json")
    disc=$(jq -r '.format.tags.DISC // .format.tags.disc // ""' <<<"$tags_json")
    disc_total=$(jq -r '.format.tags.DISCTOTAL // .format.tags.disctotal // ""' <<<"$tags_json")
    track=$(jq -r '.format.tags.TRACK // .format.tags.track // ""' <<<"$tags_json")
    track_total=$(jq -r '.format.tags.TRACKTOTAL // .format.tags.tracktotal // ""' <<<"$tags_json")
    title=$(jq -r '.format.tags.TITLE // .format.tags.title // ""' <<<"$tags_json")
    genre=$(jq -r '.format.tags.genre // ""' <<<"$tags_json")
    duration=$(jq -r '.format.duration // ""' <<<"$tags_json")
    format=$(jq -r '.format.format_name // ""' <<<"$tags_json")

    # validate file format is supported
    if [[ -z "$format" ]] || [[ ! "${supported_formats[*]}" =~ "$format" ]]; then
      echo "  - Skipped, unsupported format ($format): $file"
      continue
    fi

    # validate and clean metadata
    if [[ -z "$title" ]] || [[ -z "$artist" ]] || [[ -z "$album" ]]; then
      # TODO: attempt to fetch metadata, fallback to marking for manual tagging
      echo "  - Skipped, missing required metadata: $file"
      continue
    fi

    # set album_artist to first artist if not present
    if [[ -z "$album_artist" ]]; then
      album_artist="${artist%%,*}"
    else
      album_artist="${album_artist%%,*}"
    fi

    title=$(_remove_explicit "$title")
    track=${track%/*}
    disc=${disc%/*}
    disc_total=${disc_total%/*}
    # TODO: validate year in the event is is formatted as a full date

    # use correct file extension for the file format
    if [[ "$format" != *"$ext"* ]]; then
      ext="$format"
    fi

    # create library file path
    artist_dir=$(_format_artistdir "$album_artist")
    album_dir=$(_format_albumdir "$album" "$year")
    filename=$(_format_filename "$disc" "$track" "$title")
    library_file_dir="$library_dir/$artist_dir/$album_dir"
    library_file="$library_file_dir/$filename.$ext"

    # copy file to library location
    if [[ ! -d "$library_file_dir" ]]; then
      mkdir -p "$library_file_dir"
    fi
    if [[ ! -e "$library_file" ]]; then
      cp "$source_file" "$library_file"
      count_imported=$((count_imported + 1))
    else
      # TODO: Handle duplicates more gracefully
      echo "  Skipped - $library_file: already exists."
      count_skipped=$((count_skipped + 1))
      continue
    fi

    if [[ ! -e "$library_file" ]]; then
      echo "  Skipped - $source_file: import failed."
    else
      #TODO: delete source file
      sleep 0.1
    fi

    # LYRICS






  done < <(find "$import_dir" -maxdepth 4 -type f \( -iname '*.flac' -o -iname '*.mp3' \) -print0 | sort -z)

  count_processed=$((count_imported + count_skipped))
  end_time=$(date +%s)
  elapsed=$((end_time - start_time))

  hours=$((elapsed / 3600))
  minutes=$(((elapsed % 3600) / 60))
  seconds=$((elapsed % 60))
  printf "Processed %s files in %02dh %02dm %02ds\n" "$count_processed" "$hours" "$minutes" "$seconds"
  echo "    Imported: $count_imported"
  echo "    Skipped:  $count_skipped"
}

check() {
  echo "Checking library at $library_dir"
}

while test $# -gt 0; do
  case "$1" in
    "import")
      shift
      import
      break
      ;;
    "check")
      shift
      check
      break
      ;;
    *)
      help_msg
      break
      ;;
  esac
done

exit







count_processed=0
count_renamed=0
count_tagged=0
count_lyriced=0
count_covered=0

echo "Importing from $import_dir"

while IFS= read -r -d '' dir; do
  while IFS= read -r -d '' file; do

    # FETCH MISSING LYRICS -----------------------------------------------------
    plain_lyric_file="$filebase.txt"
    synced_lyric_file="$filebase.lrc"
    if [ ! -e "$plain_lyric_file" ] && [ ! -e "$synced_lyric_file" ]; then
      # do not attempt to fetch lyrics for live recordings
      if [[ "$title" == *"(Live)" ]] || [[ "$title" == *"(live)" ]]; then
        continue
      fi

      # sleep 200-500ms to avoid rate limits
      sleep "$(awk 'BEGIN{srand(); printf "%.3f\n", 0.2 + rand()*0.3}')"

      curl_args=(
        -sS
        --get
        --header "User-Agent: curator $version (https://github.com/boldandbrad/dotfiles/blob/main/bin/curator)"
        --data-urlencode "track_name=$title"
        --data-urlencode "album_name=$album"
        --data-urlencode "artist_name=$album_artist"
      )

      have_duration=false
      if [[ -n "${duration:-}" && $duration != "null" ]]; then
        have_duration=true
        duration_rounded=$(awk -v d="$duration" 'BEGIN { printf "%d\n", d + 0.5 }')
        curl_args+=(--data-urlencode "duration=$duration_rounded")
      fi

      max_retries=5
      attempt=0
      while :; do
        attempt=$((attempt + 1))
        lrclib_header_file=$(mktemp)
        lrclib_body_file=$(mktemp)
        trap 'rm -f "$lrclib_header_file" "$lrclib_body_file"' RETURN

        lrclib_resp_code=$(
          curl "${curl_args[@]}" \
            -D "$lrclib_header_file" \
            -o "$lrclib_body_file" \
            -w '%{http_code}' \
            "https://lrclib.net/api/get"
        )

        if [[ "$lrclib_resp_code" == "429" ]]; then
          retry_after=$(awk -F': *' 'BEGIN{IGNORECASE=1} /^Retry-After:/ {gsub("\r","",$2); print $2}' "$lrclib_header_file" | tail -n1)
          [[ -z "$retry_after" ]] && retry_after=1

          echo "  - Rate limited, retrying in ${retry_after}s"
          sleep "$retry_after"
          (( attempt >= max_retries )) && break
          continue
        fi

        if [[ "$lrclib_resp_code" != "200" ]]; then
          echo "  - Lyrics fetch failed (HTTP $lrclib_resp_code): $title"
          break
        fi

        lrclib_body=$(<"$lrclib_body_file")

        # only attempt to store lyrics if the track is not instrumental
        instrumental=$(jq -r '.instrumental // "false"' <<<"$lrclib_body")
        if [[ "$instrumental" == false ]]; then
          synced_lyrics=$(jq -r '.syncedLyrics // empty' <<<"$lrclib_body")
          plain_lyrics=$(jq -r '.plainLyrics // empty' <<<"$lrclib_body")

          if $have_duration && [[ -n "$synced_lyrics" ]]; then
            lyrics="$synced_lyrics"
            lyric_file="$synced_lyric_file"
          else
            lyrics="$plain_lyrics"
            lyric_file="$plain_lyric_file"
          fi

          if [[ -n "$lyrics" ]]; then
            printf '%b' "$lyrics" > "$lyric_file"
            echo "  - Lyrics fetched: $lyric_file"
            count_lyriced=$((count_lyriced+1))
          fi
        fi
        break
      done
    fi

    # TAG CLEANUP --------------------------------------------------------------
    # get tagging info from discogs, musicbrainz, or last.fm?
    # use flac (metaflac) for flac files and id3v2 for mp3 files, skip tagging other file formats for now

    count_processed=$((count_processed+1))
  done < <(find . -maxdepth 1 -type f \( -iname '*.flac' -o -iname '*.mp3' -o -iname '*.m4a' \) -print0 | sort -z)
done < <(find "$library_dir" -type d -print0 | sort -z)

# TODO: better output for failed changes (files without necessary tags, number of files still without lyrics, etc)

# TODO
