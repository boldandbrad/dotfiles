#!/usr/bin/env bash
#
# curator: manager of your digital music library

# WARNING: this script will modify music files directly. backup original source
# files before running this script on them.

# dependencies: ffmpeg, ffprobe, curl, jq, flac, id3v2

# library folder structure: library/artist/year - album/[d]track - title.ext

version="v0.1.0-dev"
user_agent="curator $version (https://github.com/boldandbrad/dotfiles/blob/main/bin/curator)"

dependencies=("curl" "ffmpeg" "ffprobe" "jq" "flac" "metaflac" "id3v2")
for dependency in "${dependencies[@]}"
do
  if ! command -v "$dependency" >/dev/null 2>&1; then
    echo "Error: Missing dependency '$dependency': command not found."
    echo "  - Make sure all dependencies are installed: ${dependencies[*]}"
    exit
  fi
done

# TODO: take directories in as an option or env variable
import_dir=~/Music/Import
triage_dir=~/Music/Triage
library_dir=~/Music/TestLibrary
archive_dir=~/Music/Archive

directories=("$import_dir" "$library_dir" "$triage_dir" "$archive_dir")
for directory in "${directories[@]}"
do
  if [[ ! -d "$directory" ]]; then
    mkdir -p "$directory"
  fi
done

artwork_filename="cover.jpg"
artwork_no_match_filename=".no-artwork"

supported_audio_formats=("flac" "mp3")
supported_image_formats=("jpg" "jpeg" "png")

start_time=$(date +%s)

help_msg() {
  cat <<'EOF'
usage: curator <command> [args]

commands:
  import                  Import music tracks from the import directory to the
                          library, including reformatting and lyric fetching.
  check                   COMING SOON.
  help|-h|--help          Show this help
  version|-v|--version    Show version
EOF
}

_get_tags() {
  ffprobe -v quiet -print_format json -show_format "$1" 2>/dev/null
}

_clean_path() {
  local path="$1"
  # TODO: handle cleaning with an allow list rather than denying specific characters
  local path_cleaned=${path////_} # replace / with _
  path_cleaned=${path_cleaned//./_} # replace . with _
  path_cleaned=${path_cleaned//\?/_} # replace ? with _
  path_cleaned="${path_cleaned//$'\n'/}" # remove \n
  echo "$path_cleaned"
}

_remove_explicit() {
  local string="$1"
  string=${string% Explicit}
  string=${string%Explicit}
  string=${string% (Explicit)}
  string=${string%(Explicit)}
  echo "$string"
}

_format_artistdir() {
  local album_artist="$1"

  local album_artist_cleaned=$(_clean_path "$album_artist")
  # Move 'The' to the end for sorting purposes
  if [[ "$album_artist_cleaned" == "The "* ]]; then
    album_artist_cleaned="${album_artist_cleaned#The }, The"
  fi

  echo "$album_artist_cleaned"
}

_format_albumdir() {
  local album="$1"
  local release_date="$2"

  album=$(_remove_explicit "$album")
  local album_cleaned=$(_clean_path "$album")

  echo "$release_date - $album_cleaned"
}

_format_filename() {
  local disc="$1"
  local disc_total="$2"
  local track="$3"
  local title="$4"

  local title_cleaned=$(_clean_path "$title")

  if [[ $track =~ ^[0-9]+$ ]]; then
    printf -v track '%02d' "$track"
  else
    track=""
  fi

  if [[ $disc =~ ^[0-9]+$ && $disc_total =~ ^[0-9]+$ && $disc_total -gt 1 ]]; then
    filebase="$disc$track - $title_cleaned"
  else
    filebase="$track - $title_cleaned"
  fi

  echo "$filebase"
}

_fetch_lyrics() {
  local title="$1"
  local album="$2"
  local album_artist="$3"
  local duration="$4"

  # sleep 200-500ms to avoid rate limits
  sleep "$(awk 'BEGIN{srand(); printf "%.3f\n", 0.2 + rand()*0.3}')"

  curl_args=(
    -sS
    --get
    --header "User-Agent: $user_agent"
    --data-urlencode "track_name=$title"
    --data-urlencode "album_name=$album"
    --data-urlencode "artist_name=$album_artist"
  )

  have_duration=false
  if [[ -n "${duration:-}" && $duration != "null" ]]; then
    have_duration=true
    duration_rounded=$(awk -v d="$duration" 'BEGIN { printf "%d\n", d + 0.5 }')
    curl_args+=(--data-urlencode "duration=$duration_rounded")
  fi

  local max_retries=5
  local attempt=0
  local response=""
  while :; do
    attempt=$((attempt + 1))
    lrclib_header_file=$(mktemp)
    lrclib_body_file=$(mktemp)
    trap 'rm -f "$lrclib_header_file" "$lrclib_body_file"' RETURN

    lrclib_resp_code=$(
      curl "${curl_args[@]}" \
        -D "$lrclib_header_file" \
        -o "$lrclib_body_file" \
        -w '%{http_code}' \
        "https://lrclib.net/api/get"
    )

    if [[ "$lrclib_resp_code" == "429" ]]; then
      retry_after=$(awk -F': *' 'BEGIN{IGNORECASE=1} /^Retry-After:/ {gsub("\r","",$2); print $2}' "$lrclib_header_file" | tail -n1)
      [[ -z "$retry_after" ]] && retry_after=1
      sleep "$retry_after"
      (( attempt >= max_retries )) && break
      continue
    fi

    if [[ "$lrclib_resp_code" != "200" ]]; then
      response="{ \"error\": \"$lrclib_resp_code\" }"
      break
    else
      response=$(<"$lrclib_body_file")
      break
    fi
  done
  echo "$response"
}

_find_existing_artwork() {
  local album_dir="$1"
  local image_format

  for image_format in "${supported_image_formats[@]}"; do
    if [[ -f "$album_dir/cover.$image_format" ]]; then
      printf '%s\n' "$album_dir/cover.$image_format"
      return 0
    fi
  done

  return 1
}

_fetch_artwork() {
  local album_artist="$1"
  local album_name="$2"
  local album_dir="$3"

  local artwork_file="$album_dir/$artwork_filename"
  local no_artwork_file="$album_dir/$artwork_no_match_filename"

  [[ -d "$album_dir" ]] || return 1

  if _find_existing_artwork "$album_dir" >/dev/null; then
    return 1
  fi

  if [[ -f "$no_artwork_file" ]]; then
    return 1
  fi

  audiodb_json=$(
    curl --fail --silent --show-error --location \
      --get 'https://www.theaudiodb.com/api/v1/json/2/searchalbum.php' \
      --data-urlencode "s=$album_artist" \
      --data-urlencode "a=$album_name"
  )

  cover_url=$(
    jq -r '
      [.album[]? |
        select(.strAlbumThumbHQ != null or .strAlbumThumb != null)] |
      .[0] |
      (.strAlbumThumbHQ // .strAlbumThumb // empty)
    ' <<< "$audiodb_json"
  )

  if [[ -z "$cover_url" ]]; then
    printf '  - Skipped album artwork (not found): %s - %s\n' "$album_artist" "$album_name" >&2
    : > "$no_artwork_file"
    return 1
  fi

  curl --fail --silent --show-error --location \
    --output "$artwork_file" \
    "$cover_url"

  if [[ ! -f "$artwork_file" ]]; then
    printf '  - Error: artwork download failed: %s - %s\n' "$album_artist" "$album_name" >&2
    return 1
  fi

  return 0
}

import() {
  echo "Importing music from $import_dir"

  local albums_imported_json="[]"

  count_imported=0
  count_skipped=0
  count_lyric_imported=0
  count_lyric_fetched=0
  count_retagged=0

  while IFS= read -r -d '' source_file; do
    ext="${source_file##*.}"
    ext=$(printf '%s' "$ext" | tr '[:upper:]' '[:lower:]')

    # PARSE & VALIDATE METADATA ------------------------------------------------
    tags_json=$(_get_tags "$source_file")
    artist=$(jq -r '.format.tags.ARTIST // .format.tags.artist // ""' <<<"$tags_json")
    album=$(jq -r '.format.tags.ALBUM // .format.tags.album // ""' <<<"$tags_json")
    album_artist=$(jq -r '.format.tags.ALBUM_ARTIST // .format.tags.album_artist // ""' <<<"$tags_json")
    year=$(jq -r '.format.tags.DATE // .format.tags.date // ""' <<<"$tags_json")
    disc=$(jq -r '.format.tags.DISC // .format.tags.disc // ""' <<<"$tags_json")
    disc_total=$(jq -r '.format.tags.DISCTOTAL // .format.tags.disctotal // ""' <<<"$tags_json")
    track=$(jq -r '.format.tags.TRACK // .format.tags.track // ""' <<<"$tags_json")
    track_total=$(jq -r '.format.tags.TRACKTOTAL // .format.tags.tracktotal // ""' <<<"$tags_json")
    title=$(jq -r '.format.tags.TITLE // .format.tags.title // ""' <<<"$tags_json")
    genre=$(jq -r '.format.tags.genre // ""' <<<"$tags_json")
    duration=$(jq -r '.format.duration // ""' <<<"$tags_json")
    format=$(jq -r '.format.format_name // ""' <<<"$tags_json")

    # validate file format is supported
    if [[ -z "$format" ]] || [[ ! "${supported_audio_formats[*]}" =~ "$format" ]]; then
      # TODO: fallback to marking for manual import
      echo "  - Skipped file import (unsupported format '$format'): $source_file"
      continue
    fi

    # validate and clean metadata
    if [[ -z "$title" ]] || [[ -z "$artist" ]] || [[ -z "$album" ]]; then
      # TODO: attempt to fetch metadata, fallback to marking for manual tagging
      echo "  - Skipped file import (missing required metadata): $source_file"
      continue
    fi

    # set album_artist to first artist if not present
    # TODO: Make this more reliable, some artists have a comma, &, or "and" in their name
    if [[ -z "$album_artist" ]]; then
      album_artist="${artist%%,*}"
    else
      album_artist="${album_artist%%,*}"
    fi

    title=$(_remove_explicit "$title")
    track=${track%/*}
    disc=${disc%/*}
    disc_total=${disc_total%/*}
    # TODO: validate year in the event is is formatted as a full date

    # use correct file extension for the file format
    if [[ "$format" != *"$ext"* ]]; then
      ext="$format"
    fi

    # TRACK IMPORT -------------------------------------------------------------
    artist_dir=$(_format_artistdir "$album_artist")
    album_dir=$(_format_albumdir "$album" "$year")
    filename=$(_format_filename "$disc" "$disc_total" "$track" "$title")
    library_file_dir="$library_dir/$artist_dir/$album_dir"
    library_file="$library_file_dir/$filename.$ext"

    # copy file to library location
    if [[ ! -d "$library_file_dir" ]]; then
      mkdir -p "$library_file_dir"
    fi
    if [[ ! -e "$library_file" ]]; then
      cp "$source_file" "$library_file"
      if [[ ! -e "$library_file" ]]; then
        echo "  - Error: file import failed: $album_artist - $title"
      else
        #TODO: delete source file or move it to a archive directory
        echo "  - Imported file: $album_artist - $title"
        count_imported=$((count_imported + 1))
      fi
    else
      # TODO: handle duplicates more gracefully
      echo "  - Skipped file import (already exists): $album_artist - $title"
      count_skipped=$((count_skipped + 1))
    fi

    # CACHE ALBUM --------------------------------------------------------------
    already_imported_album=$(jq "contains([{\"artist\":\"$album_artist\",\"album\":\"$album\"}])" <<< "$albums_imported_json")
    if [[ "$already_imported_album" == "false" ]]; then
      albums_imported_json=$(jq --argjson albums "$albums_imported_json" \
        --arg artist "$album_artist" \
        --arg album "$album" \
        --arg dir "$library_file_dir" \
        '$albums + [{"artist": $artist, "album": $album, "dir": $dir}]' <<<"$albums_imported_json")
    fi

    # LYRIC IMPORT/FETCH -------------------------------------------------------
    source_file_handle="${source_file%.*}"
    source_synced_lyric_file="$source_file_handle.lrc"
    source_plain_lyric_file="$source_file_handle.txt"
    library_synced_lyric_file="$library_file_dir/$filename.lrc"
    library_plain_lyric_file="$library_file_dir/$filename.txt"

    # attempt to import lyrics if file exists, fallback to fetching lyrics
    if [[ -e "$source_synced_lyric_file" ]]; then
      if [[ ! -e "$library_synced_lyric_file" ]]; then
        cp "$source_synced_lyric_file" "$library_synced_lyric_file"
        count_lyric_imported=$((count_lyric_imported + 1))
        echo "  - Imported lyrics: $album_artist - $title"
      else
        echo "  - Skipped lyric import (already exists): $album_artist - $title"
      fi
    elif [[ -e "$source_plain_lyric_file" ]]; then
      if [[ ! -e "$library_plain_lyric_file" ]]; then
        cp "$source_plain_lyric_file" "$library_plain_lyric_file"
        count_lyric_imported=$((count_lyric_imported + 1))
        echo "  - Imported lyrics: $album_artist - $title"
      else
        echo "  - Skipped lyric import (already exists): $album_artist - $title"
      fi
    else
      if [ ! -e "$library_plain_lyric_file" ] && [ ! -e "$library_synced_lyric_file" ]; then
        # do not attempt to fetch lyrics for live recordings
        if [[ ! "$title" == *"(Live)" ]] && [[ ! "$title" == *"(live)" ]]; then
          lrclib_resp=$(_fetch_lyrics "$title" "$album" "$album_artist" "$duration")
          error_found=$(echo "$lrclib_resp" | jq 'has("error")')
          if [[ "$error_found" == "true" ]]; then
            error_code=$(echo "$lrclib_resp" | jq '.error')
            echo "  - Error: lyric fetch failed: lrclib response code ($error_code): $album_artist - $title"
          else
            # only attempt to store lyrics if the track is not instrumental
            instrumental=$(jq -r '.instrumental // "false"' <<<"$lrclib_resp")
            if [[ "$instrumental" == false ]]; then
              synced_lyrics=$(jq -r '.syncedLyrics // empty' <<<"$lrclib_resp")
              plain_lyrics=$(jq -r '.plainLyrics // empty' <<<"$lrclib_resp")

              if $have_duration && [[ -n "$synced_lyrics" ]]; then
                lyrics="$synced_lyrics"
                lyric_file="$library_synced_lyric_file"
              else
                lyrics="$plain_lyrics"
                lyric_file="$library_plain_lyric_file"
              fi

              if [[ -n "$lyrics" ]]; then
                printf '%b' "$lyrics" > "$lyric_file"
                echo "  - Fetched lyrics: $album_artist - $title"
                count_lyric_fetched=$((count_lyric_fetched + 1))
              fi
            fi
          fi
        fi
      else
        echo "  - Skipped lyric fetch (already exists): $album_artist - $title"
      fi
    fi

    # TAG CLEANUP --------------------------------------------------------------
    # get tagging info from discogs, musicbrainz, or last.fm?
    # use flac (metaflac) for flac files and id3v2 for mp3 files, skip tagging other file formats for now

    # if [[ "$ext" == "flac" ]]; then
    #   echo "flac"
    #   metaflac --show-all-tags "$library_file"
    #   echo "NEWALBUMARTIST=$album_artist"
    #   echo "NEWARTIST=$artist"
    # elif [[ "$ext" == "mp3" ]]; then
    #   echo "mp3"
    #   continue
    # fi

  done < <(find "$import_dir" -maxdepth 4 -type f \( -iname '*.flac' -o -iname '*.mp3' \) -print0 | sort -z)

  # ALBUM ARTWORK FETCH --------------------------------------------------------
  count_albums_processed=$(echo "$albums_imported_json" | jq ". | length")
  count_artwork_fetched=0
  echo "Fetching album artwork"
  for (( i=0; i<$count_albums_processed; i++ )); do
    processed_album=$(echo "$albums_imported_json" | jq ".[$i]")
    album_artist=$(echo "$processed_album" | jq -r ".artist")
    album_name=$(echo "$processed_album" | jq -r ".album")
    album_mbid=$(echo "$processed_album" | jq -r ".mbid")
    album_dir=$(echo "$processed_album" | jq -r ".dir")
    if _fetch_artwork "$album_artist" "$album_name" "$album_dir"; then
      echo "  - Fetched album artwork: $album_artist - $album_name"
      count_artwork_fetched=$((count_artwork_fetched + 1))
    fi
  done

  # SUMMARY --------------------------------------------------------------------
  count_processed=$((count_imported + count_skipped))
  end_time=$(date +%s)
  elapsed=$((end_time - start_time))

  hours=$((elapsed / 3600))
  minutes=$(((elapsed % 3600) / 60))
  seconds=$((elapsed % 60))
  # TODO: processed files should include imported lyrics and covers?
  printf "\nProcessed %s files in %02dh %02dm %02ds\n" "$count_processed" "$hours" "$minutes" "$seconds"
  echo "    Tracks:"
  echo "      $count_imported/$count_processed imported"
  echo "      $count_skipped/$count_processed skipped"
  echo "    Lyrics:"
  echo "      $count_lyric_imported imported"
  echo "      $count_lyric_fetched fetched"
  echo "    Artwork:"
  echo "      $count_artwork_fetched/$count_albums_processed fetched"
}

check() {
  echo "Checking library at $library_dir"
  echo "Coming soon..."
}

while test $# -gt 0; do
  case "$1" in
    "import")
      shift
      import
      ;;
    "check")
      shift
      check
      ;;
    help|"-h"|"--help")
      help_msg
      ;;
    version|"-v"|"--version")
      echo "curator version $version"
      ;;
    *)
      help_msg
      ;;
  esac
  exit
done
help_msg

