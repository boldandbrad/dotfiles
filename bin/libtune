#!/usr/bin/env bash
#
# fine-tune and manage your music library

# WARNING: this script will modify music files directly. backup original source
# files before running this script on them.

# dependencies: ffmpeg, ffprobe, curl, jq

# library folder structure: library/artist/year - album/[d]track - title.ext

# TODO: take library in as an argument or env variable
library=~/Music/Library

start_time=$(date +%s)

count_processed=0
count_renamed=0
count_tagged=0
count_lyriced=0
count_covered=0

echo "Processing $library"

while IFS= read -r -d '' dir; do
  cd "$dir" || exit
  echo "${dir/$library/}"

  while IFS= read -r -d '' file; do
    ext="${file##*.}"
    ext=$(printf '%s' "$ext" | tr '[:upper:]' '[:lower:]')

    # grab track metadata
    tags_json=$(
      ffprobe -v quiet -print_format json -show_format "$file" 2>/dev/null
    )
    artist=$(jq -r '.format.tags.ARTIST // .format.tags.artist // ""' <<<"$tags_json")
    album=$(jq -r '.format.tags.ALBUM // .format.tags.album // ""' <<<"$tags_json")
    album_artist=$(jq -r '.format.tags.ALBUM_ARTIST // .format.tags.album_artist // ""' <<<"$tags_json")
    year=$(jq -r '.format.tags.DATE // .format.tags.date // ""' <<<"$tags_json")
    disc=$(jq -r '.format.tags.DISC // .format.tags.disc // ""' <<<"$tags_json")
    disc_total=$(jq -r '.format.tags.DISCTOTAL // .format.tags.disctotal // ""' <<<"$tags_json")
    track=$(jq -r '.format.tags.TRACK // .format.tags.track // ""' <<<"$tags_json")
    track_total=$(jq -r '.format.tags.TRACKTOTAL // .format.tags.tracktotal // ""' <<<"$tags_json")
    title=$(jq -r '.format.tags.TITLE // .format.tags.title // ""' <<<"$tags_json")
    genre=$(jq -r '.format.tags.genre // ""' <<<"$tags_json")
    duration=$(jq -r '.format.duration // ""' <<<"$tags_json")
    format=$(jq -r '.format.format_name // ""' <<<"$tags_json")

    # validate and clean metadata
    if [[ -z "$title" ]] || [[ -z "$artist" ]] || [[ -z "$album" ]]; then
      # TODO: attempt to fetch metadata, fallback to marking for manual tagging
      echo "  - Skipped, missing required metadata: $file"
      continue
    fi

    # set album_artist to first artist if not present
    if [[ -z "$album_artist" ]]; then
      album_artist="${artist%%,*}"
    fi

    title=${title% Explicit}
    title=${title%Explicit}
    track=${track%/*}
    disc=${disc%/*}
    disc_total=${disc_total%/*}

    # rename file with standard format
    # TODO: handle more filepath illegal characters/patterns (? \n)
    title_cleaned=${title////_} # replace forward slashes with underscores
    if [[ $track =~ ^[0-9]+$ ]]; then
      printf -v track '%02d' "$track"
    else
      track=""
    fi

    if [[ $disc =~ ^[0-9]+$ && $disc_total =~ ^[0-9]+$ && $disc_total -gt 1 ]]; then
      filebase="$disc$track - $title_cleaned"
    else
      filebase="$track - $title_cleaned"
    fi

    newfile="$filebase.$ext"
    # TODO: handle duplicates more gracefully - keep the higher quality one?
    if [[ ! -e $newfile && $file != "$newfile" ]]; then
      mv -- "$file" "$newfile"
      file="$newfile"
      echo "  - File renamed: $file"
      count_renamed=$((count_renamed+1))
    fi

    # fetch lyrics file if it doesn't exist
    plain_lyric_file="$filebase.txt"
    synced_lyric_file="$filebase.lrc"
    if [ ! -e "$plain_lyric_file" ] && [ ! -e "$synced_lyric_file" ]; then
      # sleep 200-500ms to avoid rate limits
      sleep "$(awk 'BEGIN{srand(); printf "%.3f\n", 0.2 + rand()*0.3}')"

      curl_args=(
        -sS
        --get
        --header "User-Agent: libtune v0.1.0 (https://github.com/boldandbrad/dotfiles/blob/main/bin/libtune)"
        --data-urlencode "track_name=$title"
        --data-urlencode "album_name=$album"
        --data-urlencode "artist_name=$album_artist"
      )

      have_duration=false
      if [[ -n "${duration:-}" && $duration != "null" ]]; then
        have_duration=true
        duration_rounded=$(awk -v d="$duration" 'BEGIN { printf "%d\n", d + 0.5 }')
        curl_args+=(--data-urlencode "duration=$duration_rounded")
      fi

      max_retries=5
      attempt=0
      while :; do
        attempt=$((attempt + 1))
        lrclib_header_file=$(mktemp)
        lrclib_body_file=$(mktemp)
        trap 'rm -f "$lrclib_header_file" "$lrclib_body_file"' RETURN

        lrclib_resp_code=$(
          curl "${curl_args[@]}" \
            -D "$lrclib_header_file" \
            -o "$lrclib_body_file" \
            -w '%{http_code}' \
            "https://lrclib.net/api/get"
        )

        if [[ "$lrclib_resp_code" == "429" ]]; then
          retry_after=$(awk -F': *' 'BEGIN{IGNORECASE=1} /^Retry-After:/ {gsub("\r","",$2); print $2}' "$lrclib_header_file" | tail -n1)
          [[ -z "$retry_after" ]] && retry_after=1

          echo "  - Rate limited, retrying in ${retry_after}s"
          sleep "$retry_after"
          (( attempt >= max_retries )) && break
          continue
        fi

        if [[ "$lrclib_resp_code" != "200" ]]; then
          echo "  - Lyrics fetch failed (HTTP $lrclib_resp_code): $title"
          break
        fi

        lrclib_body=$(<"$lrclib_body_file")
        synced_lyrics=$(jq -r '.syncedLyrics // empty' <<<"$lrclib_body")
        plain_lyrics=$(jq -r '.plainLyrics // empty' <<<"$lrclib_body")

        if $have_duration && [[ -n "$synced_lyrics" ]]; then
          lyrics="$synced_lyrics"
          lyric_file="$synced_lyric_file"
        else
          lyrics="$plain_lyrics"
          lyric_file="$plain_lyric_file"
        fi

        if [[ -n "$lyrics" ]]; then
          printf '%b' "$lyrics" > "$lyric_file"
          echo "  - Lyrics fetched: $lyric_file"
          count_lyriced=$((count_lyriced+1))
        fi
        break
      done
    fi

    # tag cleanup
    # build one ffmpeg command per file, put output in a tmp directory, validate output and then move it to the output dir

    # apple tag cleanup
    # if [[ $ext == *"m4a"* ]]; then
    #   ffmpeg -y -i "$file" -metadata -iTunSMPB="" -metadata -iTunNORM="" -metadata -iTunMOVI="" -metadata -account_id="" -metadata -purchase_date="" -c copy "$file"
    #   echo "  - Removed apple metadata for $file"
    # fi

    count_processed=$((count_processed+1))
  done < <(find . -maxdepth 1 -type f \( -iname '*.flac' -o -iname '*.mp3' -o -iname '*.m4a' \) -print0 | sort -z)
done < <(find "$library" -type d -print0 | sort -z)

end_time=$(date +%s)
elapsed=$((end_time - start_time))

hours=$((elapsed / 3600))
minutes=$(((elapsed % 3600) / 60))
seconds=$((elapsed % 60))

# TODO: better output for failed changes (files without necessary tags, number of files still without lyrics, etc)
echo
printf "Processed %s files in %02d:%02d:%02d\n" "$count_processed" "$hours" "$minutes" "$seconds"
echo "    Files renamed:    $count_renamed"
echo "    Tracks tagged:    $count_tagged (coming soon)"
echo "    Lyrics fetched:   $count_lyriced"
echo "    Artwork fetched:  $count_covered (coming soon)"

# TODO
# consider converting to more of an import model. cron job to periodically run the script on an import folder. script cleans the new files and moves them into the user's library folder
# Rename album folders to include year
# fetch cover art from theaudiodb?
# embed cover image if available?
# cleanup and standardize tags
# tag sanitization: remove any tags that you don't explicitely want
# add date/year tag if missing
# check that file extensions match file format
# remove account/purchase metadata from m4a
# flag/log tracks that lack tags or cannot be processed
# handle duplicates gracefully

# USAGE

# import all files in the import folder
# libtune import

# import specific files/folders
# libtune import file1 file2 folder1 folder2

# import only a specific format
# libtune import --fmt=flac

# import only lyric files
# libtune import --lyrics

# check library for data hygiene issues (missing cover images, missing lyrics, etc)
# libtune check


# IMPORT ORDER OF OPERATIONS
# 1. Recursively search the import dir for music files
# 2. Parse the music file's metadata
# 2.1. Check that the file extension matches the format
# 2.2. Attempt to fetch correct metadata if critical pieces are missing, fallback to moving it to a manual tagging folder
# 3. Identify formatted filename
# 4. Identify formatted album folder name
# 5. Check if library directory exists
# 6. Check if library directory already contains the file, handle duplicate
# 7. Check if library directory contains a cover image
# 7.1. Check import directory for a matching cover image
# 8. Check if library directory contains matching lyric file
# 8.1. Check import directory for a matching lyric file
# 9. Identify genre(s) using online service
# 10. Fetch missing metadata using online service
# 11. Create library album directory if it didn't exist
# 11.1. Use ffmpeg to update and clean tags and write the file to the library directory
# 12. Fetch or move the relevant lyric file and place in library directory
# 13. Fetch or move relevant cover image and place in library directory
# 14. Validate changes
# 15. Remove imported file from import directory
# 16. Repeat

# CHECK ORDER OF OPERATIONS
# 1. Recursively search the library for:
#   - Missing cover images
#   - Missing lyric files
#   - Incomplete albums
#   - Incorrect tags / filename formats
# 2. Report issues and offer to resolve automatically
