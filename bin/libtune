#!/usr/bin/env bash
#
# fine-tune and manage your music library

# WARNING: this script will modify music files directly. backup original source
# files before running this script on them.

# dependencies: ffmpeg, ffprobe, curl, jq

# library folder structure: library/artist/year - album/[d]track - title.ext

# TODO: take library in as an argument or env variable
library=~/Music/test-lyrics

count_processed=0
count_renamed=0
count_tagged=0
count_lyriced=0
count_covered=0

echo "Processing $library"

while IFS= read -r -d '' dir; do
  cd "$dir" || exit
  echo "${dir/$library/}"

  while IFS= read -r -d '' file; do
    ext="${file##*.}"
    ext=$(printf '%s' "$ext" | tr '[:upper:]' '[:lower:]')

    # grab track metadata
    tags_json=$(
      ffprobe -v quiet -print_format json -show_format "$file" 2>/dev/null
    )
    title=$(jq -r '.format.tags.TITLE // .format.tags.title // ""' <<<"$tags_json")
    disc=$(jq -r '.format.tags.DISC // .format.tags.disc // ""' <<<"$tags_json")
    disctotal=$(jq -r '.format.tags.DISCTOTAL // .format.tags.disctotal // ""' <<<"$tags_json")
    track=$(jq -r '.format.tags.TRACK // .format.tags.track // ""' <<<"$tags_json")
    album=$(jq -r '.format.tags.ALBUM // .format.tags.album // ""' <<<"$tags_json")
    artist=$(jq -r '.format.tags.ARTIST // .format.tags.artist // ""' <<<"$tags_json")
    duration=$(jq -r '.format.duration // ""' <<<"$tags_json")

    # TODO: handle more illegal characters/patterns (? \n)
    # TODO: handle when title is empty (should be rare)
    title=${title////_} # replace forward slashes with underscores
    track=${track%/*}
    disc=${disc%/*}
    disctotal=${disctotal%/*}

    # rename file with standard format
    if [[ $track =~ ^[0-9]+$ ]]; then
      printf -v track '%02d' "$track"
    else
      track=""
    fi

    if [[ $disc =~ ^[0-9]+$ && $disctotal =~ ^[0-9]+$ && $disctotal -gt 1 ]]; then
      filebase="$disc$track - $title"
    else
      filebase="$track - $title"
    fi

    newfile="$filebase.$ext"
    # TODO: handle duplicates more gracefully - keep the higher quality one?
    if [[ ! -e $newfile && $file != "$newfile" ]]; then
      mv -- "$file" "$newfile"
      file="$newfile"
      echo "  - File renamed: $file"
      count_renamed=$((count_renamed+1))
    fi

    # fetch lyrics file if it doesn't exist
    plain_lyric_file="$filebase.txt"
    synced_lyric_file="$filebase.lrc"
    if [ ! -e "$plain_lyric_file" ] && [ ! -e "$synced_lyric_file" ]; then
      # sleep 200-500ms to avoid rate limits
      sleep "$(awk 'BEGIN{srand(); printf "%.3f\n", 0.2 + rand()*0.3}')"

      curl_args=(
        -sS
        --get
        --header "User-Agent: libtune v0.1.0 (https://github.com/boldandbrad/dotfiles/blob/main/bin/libtune)"
        --data-urlencode "track_name=$title"
        --data-urlencode "album_name=$album"
        --data-urlencode "artist_name=$artist"
      )

      have_duration=false
      if [[ -n "${duration:-}" && $duration != "null" ]]; then
        have_duration=true
        duration_rounded=$(awk -v d="$duration" 'BEGIN { printf "%d\n", d + 0.5 }')
        curl_args+=(--data-urlencode "duration=$duration_rounded")
      fi

      max_retries=5
      attempt=0
      while :; do
        attempt=$((attempt + 1))
        headers_file=$(mktemp)
        body_file=$(mktemp)
        trap 'rm -f "$headers_file" "$body_file"' RETURN

        response_code=$(
          curl "${curl_args[@]}" \
            -D "$headers_file" \
            -o "$body_file" \
            -w '%{http_code}' \
            "https://lrclib.net/api/get"
        )

        if [[ "$response_code" == "429" ]]; then
          retry_after=$(awk -F': *' 'BEGIN{IGNORECASE=1} /^Retry-After:/ {gsub("\r","",$2); print $2}' "$headers_file" | tail -n1)
          [[ -z "$retry_after" ]] && retry_after=1

          echo "  - Rate limited, retrying in ${retry_after}s"
          sleep "$retry_after"
          (( attempt >= max_retries )) && break
          continue
        fi

        if [[ "$response_code" != "200" ]]; then
          echo "  - Lyrics fetch failed (HTTP $response_code)"
          break
        fi

        body=$(<"$body_file")
        synced_lyrics=$(jq -r '.syncedLyrics // empty' <<<"$body")
        plain_lyrics=$(jq -r '.plainLyrics // empty' <<<"$body")

        if $have_duration && [[ -n "$synced_lyrics" ]]; then
          lyrics="$synced_lyrics"
          lyric_file="$synced_lyric_file"
        else
          lyrics="$plain_lyrics"
          lyric_file="$plain_lyric_file"
        fi

        if [[ -n "$lyrics" ]]; then
          printf '%b' "$lyrics" > "$lyric_file"
          echo "  - Lyrics fetched: $lyric_file"
          count_lyriced=$((count_lyriced+1))
        fi
        break
      done
    fi

    # tag cleanup
    # build one ffmpeg command per file, put output in a tmp directory, validate output and then move it to the output dir

    # apple tag cleanup
    # if [[ $ext == *"m4a"* ]]; then
    #   ffmpeg -y -i "$file" -metadata -iTunSMPB="" -metadata -iTunNORM="" -metadata -iTunMOVI="" -metadata -account_id="" -metadata -purchase_date="" -c copy "$file"
    #   echo "  - Removed apple metadata for $file"
    # fi

    count_processed=$((count_processed+1))
  done < <(find . -maxdepth 1 -type f \( -iname '*.flac' -o -iname '*.mp3' -o -iname '*.m4a' \) -print0)
done < <(find "$library" -type d -print0)

echo
echo "Processed $count_processed files."
echo "    Files renamed:    $count_renamed"
echo "    Tracks tagged:    $count_tagged (coming soon)"
echo "    Lyrics fetched:   $count_lyriced"
echo "    Artwork fetched:  $count_covered (coming soon)"

# TODO
# consider converting to more of an import model. cron job to periodically run the script on an import folder. script cleans the new files and moves them into the user's library folder
# Rename album folders to include year
# embed cover image if available
# cleanup and standardize tags
# tag sanitization: remove any tags that you don't explicitely want
# add date/year tag if missing
# check that file extensions match file format
# remove account/purchase metadata from m4a
# flag/log tracks that lack tags or cannot be processed
# handle duplicates gracefully

# USAGE

# import all files in the import folder
# libtune import

# import specific files/folders
# libtune import file1 file2 folder1 folder2

# import only a specific format
# libtune import --fmt=flac

# import only lyric files
# libtune import --lyrics

# check library for data hygiene issues (missing cover images, missing lyrics, etc)
# libtune check

