#!/usr/bin/env bash
#
# fine-tune and manage your music library

# WARNING: this script will modify music files directly. backup original source
# files before running this script on them.

# dependencies: ffmpeg, ffprobe, curl, jq

# library folder structure: library/artist/year - album/[d]track - title.ext

# TODO: take library in as an argument or env variable
library=~/Music/test-lyrics

round() {
  echo $(printf %.$2f $(echo "scale=$2;(((10^$2)*$1)+0.5)/(10^$2)" | bc))
}

count_processed=0
count_renamed=0
count_tagged=0
count_lyriced=0

echo "Processing $library"

while read -r dir; do
  dir=${dir%:}
  echo ${dir/$library/}
  cd "$dir"
  while read -r file; do
    ext="${file##*.}"

    props=$(ffprobe -v quiet -print_format json -show_format "$file" 2>&1)

    # grab and clean track title
    title=$(echo $props | jq -r .format.tags.TITLE)
    [[ $title == "null" ]] && title=$(echo $props | jq -r .format.tags.title)
    # TODO: handle more illegal characters/patterns
    title=${title////_} # replace forward slashes with underscores

    # grab and clean disc and track numbers
    disc=$(echo $props | jq -r .format.tags.DISC)
    [[ $disc == "null" ]] && disc=$(echo $props | jq -r .format.tags.disc)
    if [[ $disc == *"/"* ]]; then
      disctotal=${disc##*/}
      disc=${disc%/*}
    else
      disctotal=$(echo $props | jq -r .format.tags.DISCTOTAL)
      [[ $disctotal == "null" ]] && disctotal=$(echo $props | jq -r .format.tags.disctotal)
    fi

    track=$(echo $props | jq -r .format.tags.TRACK)
    [[ $track == "null" ]] && track=$(echo $props | jq -r .format.tags.track)
    [[ $track == *"/"* ]] && track=${track%/*}
    if [[ $track != 0* ]] && [[ $track != "0" ]] && [[ ${#track} < 2 ]]; then
      track="0$track" # append leading 0 to track number
    fi

    # grab album
    album=$(echo $props | jq -r .format.tags.ALBUM)
    [[ $album == "null" ]] && album=$(echo $props | jq -r .format.tags.album)

    # grab artist
    artist=$(echo $props | jq -r .format.tags.ARTIST)
    [[ $artist == "null" ]] && artist=$(echo $props | jq -r .format.tags.artist)

    # grab duration
    duration=$(echo $props | jq -r .format.duration)

    # prepend disc number to track number if there is more than 1 disc
    if [[ $disctotal != "null" ]] && [[ $disctotal != "1" ]] && [[ $disc != "null" ]]; then
      $track="$disc$track"
    fi

    # rename track file into the format: [disc]track - title.ext
    if [[ $track == "null" ]]; then
      filebase="$title"
      newfile="$filebase.$ext"
    else
      filebase="$track - $title"
      newfile="$filebase.$ext"
    fi
    if [[ $file != $newfile ]]; then
      mv "$file" "$newfile"
      echo "  - File renamed: $newfile"
      count_renamed=$((count_renamed+1))
    fi

    # fetch lyrics file if it doesn't exist
    plain_lyric_file="$filebase.txt"
    synced_lyric_file="$filebase.lrc"
    if [ ! -e "$plain_lyric_file" ] && [ ! -e "$synced_lyric_file" ]; then
      # sleep to avoid rate limits
      sleep 0.5s

      curl_args=(
        -sS
        --get
        --header "User-Agent: libtune v0.1.0 (https://github.com/boldandbrad/dotfiles/blob/main/bin/libtune)"
        --data-urlencode "track_name=$title"
        --data-urlencode "album_name=$album"
        --data-urlencode "artist_name=$artist"
      )

      have_duration=false
      if [[ -n "${duration:-}" && $duration != "null" ]]; then
        have_duration=true
        duration_rounded=$(round "$duration" 0)
        curl_args+=(--data-urlencode "duration=$duration_rounded")
      fi

      lrclib_resp=$(
        curl "${curl_args[@]}" \
          -w $'\n%{http_code}' \
          "https://lrclib.net/api/get"
      )

      http_code="${lrclib_resp##*$'\n'}"
      body="${lrclib_resp%$'\n'*}"

      if [[ "$http_code" != "200" ]]; then
        echo "  - Lyrics fetch failed (HTTP $http_code)"
        continue
      fi

      if $have_duration; then
        lyrics=$(jq -r '.syncedLyrics // .plainLyrics // empty' <<<"$body")
        out_file="$synced_lyric_file"
      else
        lyrics=$(jq -r '.plainLyrics // empty' <<<"$body")
        out_file="$plain_lyric_file"
      fi

      if [[ -n "$lyrics" ]]; then
        printf '%b' "$lyrics" > "$out_file"
        echo "  - Lyrics fetched: $out_file"
        count_lyriced=$((count_lyriced+1))
      fi
    fi

    # tag cleanup
    # build one ffmpeg command per file, put output in a tmp directory, validate output and then move it to the output dir

    # apple tag cleanup
    # if [[ $ext == *"m4a"* ]]; then
    #   ffmpeg -y -i "$file" -metadata -iTunSMPB="" -metadata -iTunNORM="" -metadata -iTunMOVI="" -metadata -account_id="" -metadata -purchase_date="" -c copy "$file"
    #   echo "  - Removed apple metadata for $file"
    # fi

    count_processed=$((count_processed+1))
  done < <(ls -1 *.flac *.mp3 *.m4a 2>/dev/null)
  # cd $library
done < <(ls -R $library | grep :)

echo "Processed $count_processed files."
echo "    Files renamed:  $count_renamed"
echo "    Tracks tagged:  $count_tagged"
echo "    Lyrics fetched: $count_lyriced"

# TODO
# consider converting to more of an import model. cron job to periodically run the script on an import folder. script cleans the new files and moves them into the user's library folder
# Rename album folders to include year
# embed cover image if available
# cleanup and standardize tags
# tag sanitization: remove any tags that you don't explicitely want
# check that file extensions match file format
# remove account/purchase metadata from m4a
# flag/log tracks that lack tags or cannot be processed
# handle duplicates gracefully

# USAGE

# import all files in the import folder
# libtune import

# import specific files/folders
# libtune import file1 file2 folder1 folder2

# import only a specific format
# libtune import --fmt=flac

# import only lyric files
# libtune import --lyrics

